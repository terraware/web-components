{
  "extends": "./tsconfig.json",
  "exclude": [
    "src/**/*.stories.tsx",
    "src/**/*.stories.ts",
    "src/**/*.test.tsx",
    "src/**/*.test.ts",
    "src/stories",
    "src/setupTests.*"
  ],
  "compilerOptions": {
    // Generate d.ts files
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "dist",
    "declarationMap": true
  }
}

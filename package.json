{
  "name": "@terraware/web-components",
  "version": "5.1.0",
  "author": "Terraformation Inc.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/terraware/web-components.git"
  },
  "bugs": {
    "url": "https://github.com/terraware/web-components/issues"
  },
  "homepage": "https://github.com/terraware/web-components#readme",
  "private": false,
  "main": "dist/index.js",
  "dependencies": {
    "@dnd-kit/core": "^6.0.7",
    "@dnd-kit/sortable": "^10.0.0",
    "@emotion/react": "^11.11.3",
    "@emotion/styled": "^11.11.3",
    "@mui/icons-material": "^6.0.0",
    "@mui/lab": "^6.0.1-beta.36",
    "@mui/material": "^6.0.0",
    "@mui/x-date-pickers": "^7.22.0",
    "@playcanvas/react": "0.11.7",
    "classnames": "^2.3.2",
    "csv-parse": "^7.0.0",
    "embla-carousel-react": "^8.6.0",
    "geojson": "^0.5.0",
    "luxon": "^3.3.0",
    "marked": "^16.2.1",
    "material-react-table": "^3.2.1",
    "playcanvas": "2.21.3",
    "prettier": "^3.8.1",
    "react-intersection-observer": "^11.0.0",
    "react-responsive": "^10.0.0",
    "sass": "^1.75.0",
    "tinycolor2": "^1.6.0"
  },
  "scripts": {
    "start": "storybook dev",
    "build": "storybook build -c .storybook -o public",
    "test": "rstest",
    "test-coverage": "rstest --coverage",
    "format": "prettier --write .",
    "format:changed": "git diff -z --name-only --diff-filter=ACMR main -- '**.js' '**.ts' '**.tsx' '**.json' '**.css' '**.scss' '**.md' | xargs -0r prettier --write",
    "storybook": "storybook dev",
    "storybook-https": "storybook dev -p 6006 --https --ssl-cert ./certs/192.168.1.203+2.pem --ssl-key ./certs/192.168.1.203+2-key.pem --host 0.0.0.0",
    "build-dictionary": "./style-dictionary/generate.sh",
    "bundle": "rslib build",
    "generate-assets": "yarn svgr --icon --title-prop --no-dimensions --typescript -d src/components/svg assets",
    "generate-strings": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON ./scripts/generate-strings.mjs && yarn unused-strings",
    "unused-strings": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON ./scripts/unused-strings.mjs",
    "build-dist": "yarn bundle && cp package.json dist/ && node ./scripts/patch-dist-package.mjs",
    "lint": "eslint src/",
    "license-report": "license-report --only=prod --department.value=terraware --relatedTo.value=web-components --output=html > docs/license-report.html",
    "license-report-dist": "license-report --only=prod --department.value=terraware --relatedTo.value=web-components --output=html > dist/license-report.html",
    "check-updates": "yarn build-dictionary && yarn storybook",
    "prepare": "yarn generate-strings",
    "translate": "yarn run autotranslate && yarn generate-strings",
    "translate:start": "yarn run autotranslate --watch",
    "ts": "tsc --project ./tsconfig.json"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@jsdevtools/version-bump-prompt": "^6.1.0",
    "@rsbuild/core": "^2.2.11",
    "@rsbuild/plugin-react": "^2.1.0",
    "@rsbuild/plugin-sass": "^2.0.1",
    "@rslib/core": "^1.0.3",
    "@rstest/core": "^0.12.0",
    "@rstest/coverage-istanbul": "^0.12.0",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/addon-links": "^10.6.1",
    "@storybook/react": "^10.6.1",
    "@svgr/cli": "^8.0.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^14.3.0",
    "@testing-library/user-event": "^14.0.0",
    "@trivago/prettier-plugin-sort-imports": "^6.0.0",
    "@types/lodash": "^4.17.23",
    "@types/luxon": "^3.2.0",
    "@types/mapbox-gl": "^3.4.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/react-map-gl": "^6.1.7",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-jsdoc": "^65.0.0",
    "eslint-plugin-prefer-arrow": "^1.2.3",
    "eslint-plugin-react": "^7.37.5",
    "fs": "^0.0.1-security",
    "globals": "^17.9.0",
    "hex-rgb": "^5.0.0",
    "jsdom": "^30.0.1",
    "license-report": "^6.5.0",
    "llm-autotranslate": "^1.0.0",
    "mapbox-gl": "^3.13.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-map-gl": "^8.0.4",
    "storybook": "^10.6.1",
    "storybook-react-rsbuild": "^3.6.0",
    "style-dictionary": "^5.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.66.0"
  },
  "peerDependencies": {
    "@playcanvas/react": "0.11.7",
    "mapbox-gl": "^3.13.0",
    "playcanvas": "2.21.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-map-gl": "^8.0.4"
  },
  "resolutions": {
    "wrap-ansi": "10.0.2",
    "string-width": "8.3.0"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
